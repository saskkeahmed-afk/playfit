# عنوان الموقع الإنتاجي (بدون / في النهاية). مطلوب لـ canonical وsitemap وrobots.
# اتركه فارغاً أثناء التطوير؛ لن تُنشر روابط canonical بدونه.
NEXT_PUBLIC_SITE_URL=

# --- صور الأغلفة (اختياري) ---
# مفتاح RAWG API (https://rawg.io/apidocs). يبقى على الخادم فقط ولا يُكشف للمتصفح.
RAWG_API_KEY=

# --- نموذج التواصل (اختياري) ---
# بدون هذه القيم يعرض النموذج رسالة صريحة بأن الإرسال غير مفعّل ولا يتظاهر بالإرسال.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- الإعلانات (معطّلة افتراضياً) ---
# لا تفعّلها قبل قبول الموقع في AdSense ومراجعة سياسات الموافقة.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
# ca-pub-XXXXXXXXXXXXXXXX بدون "ca-"  مثال سطر ads.txt: google.com, pub-XXXX, DIRECT, f08c47fec0942fa0
ADS_TXT_LINE=

# بريد يظهر كبديل عند فشل النموذج (اختياري؛ NEXT_PUBLIC يعني أنه عام بطبيعته)
NEXT_PUBLIC_CONTACT_EMAIL=
